rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // POC rule: authenticated Manager/Guard clients may access call requests.
    // Role-specific authorization will be tightened when the role model is added.
    match /callRequests/{requestId} {
      allow read, write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
