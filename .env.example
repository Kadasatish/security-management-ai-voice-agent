# Firebase browser config (public client config; protect data with Firebase rules)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# LiveKit public server URL only. Never put the LiveKit API secret here.
VITE_LIVEKIT_URL=

# Backend endpoint that will issue short-lived LiveKit tokens.
VITE_VOICE_TOKEN_ENDPOINT=
